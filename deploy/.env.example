# DevDigest server-mode deployment settings — PLACEHOLDERS ONLY.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# then replace every `replace-me…` value. Never commit deploy/.env.
# Values reach containers at runtime only; nothing here is baked into an image,
# EXCEPT the public web build args (SENTRY_WEB_DSN, SENTRY_ENVIRONMENT), which are
# inlined into the browser bundle at build time.
#
# Every setting carries a metadata line directly above it (checked by
# deploy/check-compose.sh, AC-8):
#   # <secret|non-secret> <required|optional> default: <value|none>
# An optional setting left empty uses its default.

# Bare public DNS name (no scheme, no port, no path). Must resolve to this VM
# so Caddy can obtain the certificate. Origin = https://<host>, API = https://<host>/api
# non-secret required default: none
PUBLIC_HOSTNAME=devdigest.example.com

# Three Postgres roles (internal only; see the "Database roles" block in compose.yml):
#  - POSTGRES_PASSWORD  → `devdigest`, the owner/superuser. Used ONLY by postgres
#    (first boot) and the one-shot `migrate` service — never by the API.
#  - APP_DB_PASSWORD    → `devdigest_app`, the least-privilege runtime role the API
#    connects as (DML only; audit_events is SELECT + INSERT). Created / re-keyed by
#    `migrate` on every `up` (never by postgres init). Must differ from
#    POSTGRES_PASSWORD.
#  - BACKUP_DB_PASSWORD → `devdigest_backup`, the read-only role the `backup`
#    service dumps as (pg_read_all_data, read-only transactions). Created / re-keyed
#    by `migrate` on every `up`. Must differ from both passwords above.
# ALL must be >= 32 chars of [A-Za-z0-9_-] (the owner one too — it holds every right).
# Generate each with `openssl rand -hex 24` (48 hex chars, URL-safe — they are
# embedded in DATABASE_URL). `migrate` FAILS on the `replace-me…` placeholders below
# or any shorter / non-URL-safe value; `bash deploy/check-compose.sh deploy/.env`
# flags them before you deploy.
# Rotate APP_DB_PASSWORD / BACKUP_DB_PASSWORD: set the new value here, then
#   deploy/dc.sh up -d     # migrate re-keys, api / backup restart
# secret required default: none
POSTGRES_PASSWORD=replace-me-openssl-rand-hex-24
# secret required default: none
APP_DB_PASSWORD=replace-me-app-openssl-rand-hex-24
# secret required default: none
BACKUP_DB_PASSWORD=replace-me-backup-openssl-rand-hex-24

# Google OIDC web client. Authorized redirect URI:
#   https://<PUBLIC_HOSTNAME>/api/auth/google/callback
# non-secret required default: none
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# secret required default: none
GOOGLE_CLIENT_SECRET=replace-me
# Email / Google Workspace domain allowed to sign in.
# non-secret required default: none
AUTH_ALLOWED_DOMAIN=example.com
# Comma-separated emails granted Admin on first sign-in.
# non-secret optional default: none
AUTH_ADMIN_EMAILS=

# AES-256-GCM master key: base64 of exactly 32 random bytes (`openssl rand -base64 32`).
# Losing it makes every stored provider secret undecryptable — back it up off-VM.
# secret required default: none
SECRETS_MASTER_KEY=replace-me-openssl-rand-base64-32
# Previous master key during a rotation.
# secret optional default: none
SECRETS_MASTER_KEY_PREVIOUS=

# Tuning.
# non-secret optional default: info
LOG_LEVEL=info
# non-secret optional default: false
EMBEDDINGS_ENABLED=false
# non-secret optional default: true
REPO_INTEL_ENABLED=true

# ── Backups (nightly pg_dump by the `backup` service) ────────────────────────
# Daily dump time, HH:MM in UTC.
# non-secret optional default: 03:15
BACKUP_SCHEDULE=03:15
# Nightly dumps kept (min 1).
# non-secret optional default: 14
BACKUP_RETAIN=14
# Pre-update dumps kept (min 1); made by deploy/update.sh before every update.
# non-secret optional default: 5
BACKUP_RETAIN_PRE_UPDATE=5
# Host directory for dumps (relative paths are relative to deploy/). Must be
# writable by uid 999: `sudo install -d -m 0700 -o 999 -g 999 <dir>`.
# Copy dumps off the VM yourself — they are local only.
# non-secret optional default: ./backups
BACKUP_DIR=

# ── Error reporting (Sentry, opt-in; empty DSN = off) ────────────────────────
# API DSN, read at runtime by `api`. Treat as sensitive: never shown in the UI,
# logs or the web bundle.
# secret optional default: none
SENTRY_DSN=
# Web DSN — PUBLIC, build-time: inlined into the browser bundle, so changing it
# needs a rebuild (deploy/dc.sh up -d --build). If the proxy CSP ever restricts
# connect-src, it must allow this DSN's https://<host> origin.
# non-secret optional default: none
SENTRY_WEB_DSN=
# Environment tag on api and web events (web: build time).
# non-secret optional default: production
SENTRY_ENVIRONMENT=production

# ── Log rotation (every service, json-file driver) ───────────────────────────
# non-secret optional default: 10m
LOG_MAX_SIZE=10m
# non-secret optional default: 5
LOG_MAX_FILE=5

# ── Resource limits per service (memory / CPUs) ──────────────────────────────
# non-secret optional default: 256m
PROXY_MEM_LIMIT=256m
# non-secret optional default: 0.5
PROXY_CPUS=0.5
# non-secret optional default: 512m
WEB_MEM_LIMIT=512m
# non-secret optional default: 1.0
WEB_CPUS=1.0
# non-secret optional default: 2g
API_MEM_LIMIT=2g
# non-secret optional default: 1.5
API_CPUS=1.5
# non-secret optional default: 1g
MIGRATE_MEM_LIMIT=1g
# non-secret optional default: 1.0
MIGRATE_CPUS=1.0
# non-secret optional default: 1g
POSTGRES_MEM_LIMIT=1g
# non-secret optional default: 1.0
POSTGRES_CPUS=1.0
# non-secret optional default: 512m
BACKUP_MEM_LIMIT=512m
# non-secret optional default: 0.5
BACKUP_CPUS=0.5

# ── Updates (deploy/update.sh) ───────────────────────────────────────────────
# Branch the VM tracks (read through a read-only deploy key).
# non-secret optional default: main
DEPLOY_BRANCH=main
# Git remote to fetch from.
# non-secret optional default: origin
DEPLOY_REMOTE=origin
# Seconds to wait for api + web to turn healthy after an update.
# non-secret optional default: 180
UPDATE_HEALTH_TIMEOUT=180

# Fixed in compose.yml, not configurable here: AUTH_MODE=google, NODE_ENV=production,
# TRUST_PROXY=172.28.0.10 (the proxy's static IP), DEVDIGEST_CLONE_DIR=/data/clones,
# NEXT_PUBLIC_API_BASE=/api (web build arg).
# Not settings: DEVDIGEST_RELEASE / DEVDIGEST_IMAGE_TAG live in deploy/.state/release.env
# (written by deploy/update.sh, exported by deploy/dc.sh).
# Provider tokens / LLM keys are NOT env settings in server mode: an Admin enters
# them in Settings (encrypted in Postgres), or import once with
#   deploy/dc.sh run --rm -e GITHUB_TOKEN api pnpm secrets:import
