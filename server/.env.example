# @devdigest/api environment
DATABASE_URL=postgres://devdigest:devdigest@localhost:5432/devdigest

# LLM providers (BYO key — entered via Settings UI in prod; env for local dev).
# Optional: the app boots with none. A key is only needed for the provider you
# actually run a review on (or embeddings, see EMBEDDINGS_ENABLED).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# GitHub (REST via Octokit) — PAT with repo scope. Canonical name is
# GITHUB_TOKEN; GITHUB_PAT is still accepted as a fallback for back-compat.
GITHUB_TOKEN=

# Memory/RAG embeddings (OpenAI text-embedding-3-small). Default OFF → the app
# makes ZERO OpenAI requests. Set true to enable memory retrieval.
EMBEDDINGS_ENABLED=false

# repo-intel facade (Tier 1: repo skeleton + callers in the review prompt).
# Default ON; set false to degrade every consumer to ripgrep-only behavior.
REPO_INTEL_ENABLED=true

API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (defaults: info, silent in test)
LOG_LEVEL=
DEVDIGEST_CLONE_DIR=./clones

# ── Auth mode ────────────────────────────────────────────────────────────────
# local (default) = single-user, no sign-in — exactly today's behaviour.
# google          = multi-user server mode (Google sign-in, Admin/Member roles,
#                   encrypted secrets in Postgres). Any other value fails boot.
AUTH_MODE=
# local mode refuses to boot with NODE_ENV=production unless this is "true".
ALLOW_UNAUTHENTICATED_LOCAL_MODE=

# ── Server mode (required when AUTH_MODE=google) ─────────────────────────────
# Google OIDC web client. The secret is a deployment secret: env only, never logged.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email / Google Workspace (hd) domain allowed to sign in, e.g. onlytraf.com
AUTH_ALLOWED_DOMAIN=
# Optional comma-separated admin allowlist (granted Admin on first sign-in).
AUTH_ADMIN_EMAILS=
# Public host[:port] only — no scheme or path. Origin = https://<host>, API = https://<host>/api
PUBLIC_HOSTNAME=
# AES-256-GCM master key: base64 of exactly 32 random bytes (`openssl rand -base64 32`).
SECRETS_MASTER_KEY=
# Optional: the previous master key during a rotation (re-encrypted on boot).
SECRETS_MASTER_KEY_PREVIOUS=
# Optional comma-separated IP/CIDR list of trusted reverse proxies (Fastify trustProxy).
# Unset = trust nothing (X-Forwarded-* ignored).
TRUST_PROXY=
