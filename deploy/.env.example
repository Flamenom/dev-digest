# DevDigest server-mode deployment settings — PLACEHOLDERS ONLY.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# then replace every `replace-me…` value. Never commit deploy/.env.
# Values reach containers at runtime only; nothing here is baked into an image.

# Bare public DNS name (no scheme, no port, no path). Must resolve to this VM
# so Caddy can obtain the certificate. Origin = https://<host>, API = https://<host>/api
PUBLIC_HOSTNAME=devdigest.example.com

# Two Postgres roles (internal only; see the "Database roles" block in compose.yml):
#  - POSTGRES_PASSWORD → `devdigest`, the owner/superuser. Used ONLY by postgres
#    (first boot) and the one-shot `migrate` service — never by the API.
#  - APP_DB_PASSWORD   → `devdigest_app`, the least-privilege runtime role the API
#    connects as (DML only; audit_events is SELECT + INSERT). Created / re-keyed by
#    `migrate` on every `up` (never by postgres init). Must differ from
#    POSTGRES_PASSWORD and be >= 32 chars of [A-Za-z0-9_-].
# Generate each with `openssl rand -hex 24` (48 hex chars, URL-safe — they are
# embedded in DATABASE_URL). `migrate` FAILS on the `replace-me…` placeholders below
# or any shorter / non-URL-safe value; `bash deploy/check-compose.sh deploy/.env`
# flags them before you deploy.
# Rotate APP_DB_PASSWORD: set the new value here, then
#   docker compose -f deploy/compose.yml up -d     # migrate re-keys, api restarts
POSTGRES_PASSWORD=replace-me-openssl-rand-hex-24
APP_DB_PASSWORD=replace-me-app-openssl-rand-hex-24

# Google OIDC web client. Authorized redirect URI:
#   https://<PUBLIC_HOSTNAME>/api/auth/google/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Email / Google Workspace domain allowed to sign in.
AUTH_ALLOWED_DOMAIN=example.com
# Optional comma-separated emails granted Admin on first sign-in.
AUTH_ADMIN_EMAILS=

# AES-256-GCM master key: base64 of exactly 32 random bytes (`openssl rand -base64 32`).
# Losing it makes every stored provider secret undecryptable — back it up off-VM.
SECRETS_MASTER_KEY=replace-me-openssl-rand-base64-32
# Optional: previous master key during a rotation.
SECRETS_MASTER_KEY_PREVIOUS=

# Optional tuning (defaults shown).
LOG_LEVEL=info
EMBEDDINGS_ENABLED=false
REPO_INTEL_ENABLED=true

# Fixed in compose.yml, not configurable here: AUTH_MODE=google, NODE_ENV=production,
# TRUST_PROXY=172.28.0.10 (the proxy's static IP), DEVDIGEST_CLONE_DIR=/data/clones,
# NEXT_PUBLIC_API_BASE=/api (web build arg).
# Provider tokens / LLM keys are NOT env settings in server mode: an Admin enters
# them in Settings (encrypted in Postgres), or import once with
#   docker compose -f deploy/compose.yml run --rm -e GITHUB_TOKEN api pnpm secrets:import
